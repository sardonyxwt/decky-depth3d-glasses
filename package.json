{
  "name": "decky-depth3d-glasses",
  "version": "0.2.1",
  "description": "Marks Steam games that have a Depth3D (SuperDepth3D) profile and installs ReShade + SuperDepth3D for SBS 3D on XR glasses",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 tests/test_backend.py"
  },
  "keywords": ["decky", "plugin", "reshade", "depth3d", "sbs", "xr-glasses", "viture"],
  "author": "Kyrylo",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
